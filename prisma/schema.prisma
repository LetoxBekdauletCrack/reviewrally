generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Review {
  id         String   @id @default(cuid())
  author     String
  text       String?
  rating     Int
  sentiment  String
  category   String
  businessId String   @default("biz-1")
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([sentiment])
  @@index([category])
}

model User {
  id         String   @id @default(cuid())
  name       String?
  email      String   @unique
  password   String
  businessId String   @default("biz-1")
  createdAt  DateTime @default(now())
}

model Business {
  id        String   @id @default(cuid())
  name      String
  tier      String   @default("pro")
  createdAt DateTime @default(now())
}

model Subscription {
  id              String   @id @default(cuid())
  businessId      String   @unique
  tier            String
  status          String   @default("active")
  stripeSessionId String?
  updatedAt       DateTime @updatedAt
}
